[global]
  p: 8086
  xff-src: lan
  rproxy: 1
  e2dsa          # file indexing and filesystem scanning
  e2ts           # multimedia indexing
  z, qr          # zeroconf and qrcode
[accounts]
  mukesh: ${COPYPARTY_MUKESH_PASSWORD}
  anurag: ${COPYPARTY_ANURAG_PASSWORD}
  ayaan: ${COPYPARTY_AYAAN_PASSWORD}

[/]
  .
  accs:
    r: *
    rwmd: mukesh, anurag

[/media]
  ./media
  accs:
    r: anurag
    rwmd: mukesh

[/pictures]
  ./pictures
  accs:
    r: *
    rwmd: mukesh, anurag, ayaan
